    { "name": "diamond", "cards": { "a": {}, "b": {}, "c": {}, "d": {} }, "connections": { "1": { "source": "a", "target": "c" }, "2": { "source": "a", "target": "b" }, "3": { "source": "b", "target": "d" }, "4": { "source": "c", "target": "d" } }, "expect": ["a", "b", "c", "d"] },
    { "name": "cycle", "cards": { "a": {}, "b": {} }, "connections": { "1": { "source": "a", "target": "b" }, "2": { "source": "b", "target": "a" } }, "expect": "cycle" },
