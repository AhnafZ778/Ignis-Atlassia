      "state": { "study": {} },
      "source": { "follow": "pinned", "pinned_study": { "context": { "region": "norcal", "bbox": [-122, 39, -120, 41], "start": "2015-07-01", "end": "2015-07-31" } } },
      "target": { "follow": "pinned", "pinned_study": { "context": { "region": "punjab-haryana", "bbox": [73, 29, 77, 32], "start": "2015-07-01", "end": "2015-07-31" } } },
