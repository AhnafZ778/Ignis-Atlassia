      "snapshots": { "s1": { "release_id": "r1", "unit": "records" }, "s2": { "release_id": "r2", "unit": "ratio" } },
      "expect": ["Evidence comes from different releases.", "A shared scale needs the same operation.", "Units differ: records and ratio."]
    },
    {
      "name": "families must match",
      "state": { "study": {} },
      "source": { "binding": { "operation": "replay" } }, "target": { "binding": { "operation": "research" } }, "kind": "context", "snapshots": {},
