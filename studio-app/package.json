{
  "name": "fireatlas-studio-app",
  "private": true,
  "version": "0.1.0",
  "description": "Ignis-Atlassia Research Studio authoring island (React + TypeScript + Vite). Built output is committed to fireatlas/static/studio-assets/.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/excalidraw-sdk.mjs && node scripts/postbuild.mjs",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@liveblocks/client": "3.24.3",
    "@napi-rs/canvas": "1.0.10",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldraw": "5.5.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
